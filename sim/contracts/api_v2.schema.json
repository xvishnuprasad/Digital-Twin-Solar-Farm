{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar-twin/api/v2",
  "title": "Emulator GET /api/v2 response (N-panel farm mode)",
  "description": "Versioned, emulator-only contract for multi-panel consumers. Not served by the current firmware.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "t_ms", "timestamp", "irradiance_wm2", "ambient_c", "panels"],
  "properties": {
    "schema": {"const": "solar-twin/v2"},
    "t_ms": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string"},
    "irradiance_wm2": {"type": "number", "minimum": 0, "maximum": 1500},
    "ambient_c": {"type": "number"},
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "voltage", "current", "power_w", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]+$"},
          "voltage": {"type": "number", "minimum": 0},
          "current": {"type": "number", "minimum": 0},
          "power_w": {"type": "number", "minimum": 0},
          "status": {"enum": ["RED", "YELLOW", "GREEN"]}
        }
      }
    }
  }
}
